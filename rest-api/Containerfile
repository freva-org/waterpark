# Production image for the Waterpark API.
#
# Not Containerfile.dev, which installs the package editable and runs
# uvicorn with autoreload against a bind-mounted source tree. This one
# builds a wheel, installs it into a virtual environment, and copies only
# that environment into a fresh layer, so the final image carries no
# compiler, no build backend and no source checkout.

# --- build ------------------------------------------------------------------
FROM docker.io/library/python:3.12-slim AS build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /src

# flit reads the version and the description out of the package, so the
# source has to be present before the wheel can be built.
COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip wheel \
    && /opt/venv/bin/pip install .

# --- runtime ----------------------------------------------------------------
FROM docker.io/library/python:3.12-slim

LABEL org.opencontainers.image.title="waterpark-api" \
      org.opencontainers.image.description="Newsletter and announcements API for waterpark.dkrz.de" \
      org.opencontainers.image.source="https://github.com/freva-org/waterpark" \
      org.opencontainers.image.licenses="BSD-3-Clause"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    # Sensible defaults for a container. Everything else comes from the
    # environment or from a secret mounted under /run/secrets; see
    # waterpark_api.config for the resolution order.
    WATERPARK_DB_TYPE=postgresql \
    WATERPARK_LOGDIR=/var/lib/waterpark/logs \
    WATERPARK_ANNOUNCEMENTS_PATH=/var/lib/waterpark/announcements.toml \
    WATERPARK_PORT=8080

COPY --from=build /opt/venv /opt/venv

# A fixed uid so a Quadlet volume keeps working across image rebuilds, and
# so the host can chown the state directory without guessing.
RUN groupadd --system --gid 10001 waterpark \
    && useradd --system --uid 10001 --gid waterpark \
        --home-dir /var/lib/waterpark --no-create-home waterpark \
    && mkdir -p /var/lib/waterpark/logs \
    && chown -R waterpark:waterpark /var/lib/waterpark

USER waterpark
WORKDIR /var/lib/waterpark
VOLUME ["/var/lib/waterpark"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=4).status == 200 else 1)"]

ENTRYPOINT ["python", "-m", "waterpark_api"]
CMD ["--port", "8080"]
