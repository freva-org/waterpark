# Development image for the Waterpark landing page.
#
# Serves mkdocs with live reload. Node is here because the STAC browser and
# the data browser are vendored in by scripts/build_*_docs.py, which run npm
# and drop the built bundles into .build/.

FROM docker.io/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# git: the vendoring scripts clone the upstream browsers.
# libcairo2 and the image libraries: mkdocs-material's social plugin needs
# them at runtime, and the failure without them is an unhelpful import error.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        libcairo2 \
        libfreetype6 \
        libjpeg62-turbo \
        libpng16-16 \
        nodejs \
        npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

COPY requirements-docs.txt ./
RUN pip install --no-cache-dir -r requirements-docs.txt

COPY entrypoint.dev.sh /usr/local/bin/docs-entrypoint
RUN chmod +x /usr/local/bin/docs-entrypoint

EXPOSE 8000

ENTRYPOINT ["docs-entrypoint"]
