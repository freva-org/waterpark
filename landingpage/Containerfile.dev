# Development image for the Waterpark landing page.
#
# Serves the Astro Starlight site with live reload. The Freva parts are
# whatever `just site::prepare` left in .prepared/; without them the site
# still serves, with plain code blocks and the widget pages' fallback text.

FROM docker.io/library/node:24-slim

# python3 renders the example pages (scripts/build_examples.py --render,
# offline, standard library only); git is for nothing at runtime but keeps
# npm quiet about lifecycle scripts that probe for it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        python3 \
    && rm -rf /var/lib/apt/lists/*

ENV ASTRO_TELEMETRY_DISABLED=1

WORKDIR /work

COPY entrypoint.dev.sh /usr/local/bin/docs-entrypoint
RUN chmod +x /usr/local/bin/docs-entrypoint

EXPOSE 8000

ENTRYPOINT ["docs-entrypoint"]
