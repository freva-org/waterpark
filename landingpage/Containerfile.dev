# Development image for the Waterpark landing page.
#
# Serves mkdocs with live reload, with the Freva parts `just site::prepare` left in .prepared/.

FROM docker.io/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# libcairo2 and the image libraries: mkdocs-material's social plugin needs
# them at runtime, and the failure without them is an unhelpful import error.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libcairo2 \
        libfreetype6 \
        libjpeg62-turbo \
        libpng16-16 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

COPY requirements-docs.txt ./
RUN pip install --no-cache-dir -r requirements-docs.txt

COPY entrypoint.dev.sh /usr/local/bin/docs-entrypoint
RUN chmod +x /usr/local/bin/docs-entrypoint

EXPOSE 8000

ENTRYPOINT ["docs-entrypoint"]
