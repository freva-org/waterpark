# Waterpark landing page.
#
#   just            list every recipe
#   just serve      docs on :8000 with live reload
#
# Docs only. Running the docs alongside listmonk and a mailbox is the
# workspace justfile's job, one directory up: `just dev` there. Everything
# here works with this directory on its own, and from the root as
# `just site::<recipe>`.
#
# The site is Astro Starlight, built with npm; `npm run build` does the
# whole build (generated pages, then astro), so these recipes add only what
# npm cannot know: installing first, the empty API base for anything
# published, and gh-pages. tox runs the Python jobs (shared pin, examples,
# spelling). CI calls these same recipes.

set shell := ["bash", "-euo", "pipefail", "-c"]

state_dir := env("STATE_DIR", source_directory() / ".dev")

# Astro's minimum. Older versions fail with errors that do not say so.
node_min := "22.23.4"

# Every recipe below runs what it needs first, so pick the one you want and
# nothing else:
#
#   install  ->  prepare  ->  serve
#                         ->  build  ->  check
#                                    ->  deploy

[private]
default:
    @just --list

# Check Node, then npm ci when package-lock.json or the Node major changed
[private]
install:
    #!/usr/bin/env bash
    set -euo pipefail
    have="$(node --version 2>/dev/null | sed 's/^v//')" || true
    if [ -z "$have" ]; then
        echo "node not found: install Node {{ node_min }} or newer" >&2
        exit 1
    fi
    if [ "$(printf '%s\n%s\n' "{{ node_min }}" "$have" | sort -V | head -1)" != "{{ node_min }}" ]; then
        echo "Node $have is too old: the site needs {{ node_min }} or newer ($(command -v node))" >&2
        exit 1
    fi
    stamp=node_modules/.waterpark-install
    want="$(sha256sum package-lock.json | cut -d' ' -f1) node-${have%%.*}"
    if [ "$(cat "$stamp" 2>/dev/null)" != "$want" ]; then
        echo "installing dependencies (package-lock.json or Node changed)"
        npm ci --no-audit --no-fund
        echo "$want" > "$stamp"
    fi

# WP_API_BASE and WP_LIST_UUID are read at build time and end up in the
# rendered HTML. WP_API_BASE must be empty for anything that gets published:
# in production the site and the API share an origin.

# Build the Freva parts (Python, notebook, tree, STAC and Data Browser) into .prepared/; ~10 min the first time, seconds after
[group('docs')]
prepare *args: install
    ./scripts/fetch-wheels.sh || echo "no healpix-geo wheel: the examples that import it will not run in the browser"
    node scripts/prepare.mjs {{ args }}

# Serve the docs at localhost:8000 with live reload
[group('docs')]
serve: prepare
    exec npm run dev

# Build the site into ./dist, internal links checked
[group('docs')]
build: prepare
    WP_API_BASE= npm run build

# Publish ./dist to gh-pages as one commit, "docs: <sha>" unless a message is given
[confirm("Publish to gh-pages by hand? CI normally does this. [y/N]")]
[group('docs')]
deploy message="": build
    ./scripts/publish-gh-pages.sh dist {{ quote(message) }}

# Everything CI runs: shared pin, examples freshness, spelling, the build
[group('docs')]
check: build
    tox -e shared-check,examples-check,spell

# --- content maintenance ----------------------------------------------------

# Verify the vendored shared docs still match the pin
[group('content')]
shared:
    python3 scripts/sync_shared.py --check

# Re-pin the shared docs to grid-doctor's tip
[group('content')]
shared-update:
    python3 scripts/sync_shared.py --update

# Redraw the logo and icons in assets/ from HEALPix geometry
[group('content')]
logo: install
    node scripts/make-logo.mjs

# Refresh the dataset listing from the live S3 endpoint
[group('content')]
buckets:
    python3 scripts/refresh_buckets.py

# Report whether the dataset listing is stale
[group('content')]
buckets-check:
    python3 scripts/refresh_buckets.py --check

# The examples go to the network; the docs build does not. Refreshing the
# figures is therefore its own step, run when an example changes rather than
# on every build.

# Run the examples and refresh their figures; `just examples 03` for one
[group('content')]
examples only="":
    tox -e examples -- {{ if only != "" { "--only " + quote(only) } else { "" } }}

# Report examples whose figures no longer match their code
[group('content')]
examples-check:
    tox -e examples-check

# Remove build output and local state
[group('docs')]
clean:
    rm -rf dist .astro .cache .prepared "{{ state_dir }}"
    [ ! -f src/content/docs/.gitignore ] || git clean -fqX src/content/docs
    @echo "cleaned"
