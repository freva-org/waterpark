# Installed at /opt/waterpark/catalogue.env, mode 0600, root-owned.
# systemd reads it as root before dropping privileges, so the service user
# never needs access to it.

# `waterpark-catalogue-ro` cleint ID and private key
CATALOGUE_APP_ID=CHANGE-ME
CATALOGUE_APP_KEY=/opt/waterpark/catalogue-app.pem

# In case if we wanted to switch the approach for reading the artifacts
# CATALOGUE_GITHUB_TOKEN=github_pat_...

# Where failure notifications go. Leave unset to log only.
# WATERPARK_NOTIFY_TO=waterpark-admin@dkrz.de

# Load each dataset's SQL dump into this database as well, one schema per
# dataset. Leave unset for Solr only; needs psql on the machine.
# CATALOGUE_POSTGRES=postgresql://waterpark:pw@localhost:5432/waterpark
