# Single origin for development, matching what nginx does in production.
#
# The routing table below is the contract between the two. Every path here
# has a counterpart in rest-api/nginx.conf, and a change to one without the
# other is how a thing that works locally 404s on the VM.

{
	admin off
	auto_https off
}

:80 {
	log {
		output stdout
		format console
	}

	# --- the announcement banner -----------------------------------------
	# A file, not a service. The banner script fetches this path and does
	# the window filtering itself, so an entry with a past `expires`
	# disappears without anything server-side deciding.
	handle /api/announcements {
		root * /srv/announcements
		rewrite * /announcements.json
		header Content-Type application/json
		header Cache-Control "public, max-age=60"
		# No file means nothing to announce, which is not an error.
		try_files {path} /empty.json
		file_server
	}

	# --- the newsletter ---------------------------------------------------
	# The widget keeps posting to /api/newsletter/subscribe, which is
	# rewritten to listmonk's public endpoint. Two reasons for the rewrite
	# rather than changing the URL in the built site: the site stays free
	# of listmonk's URL shape, and the path is unchanged from the previous
	# stack, so an old cached page still works.
	#
	# /api/public/subscription rather than /subscription/form: the form
	# endpoint answers with an HTML page, the public API answers JSON,
	# which is what the widget parses.
	handle /api/newsletter/subscribe {
		rewrite * /api/public/subscription
		reverse_proxy listmonk:9000
	}

	# listmonk's own pages: the admin UI, the hosted subscription and
	# unsubscribe pages, and the click/view tracking endpoints that appear
	# in every message it sends.
	handle /admin* {
		reverse_proxy listmonk:9000
	}
	handle /api/* {
		reverse_proxy listmonk:9000
	}
	handle /subscription/* {
		reverse_proxy listmonk:9000
	}
	handle /link/* {
		reverse_proxy listmonk:9000
	}
	handle /campaign/* {
		reverse_proxy listmonk:9000
	}
	handle /uploads/* {
		reverse_proxy listmonk:9000
	}
    handle /public/* {
    reverse_proxy listmonk:9000
}

	# --- the mailbox ------------------------------------------------------
	handle /mailbox/* {
		reverse_proxy mailbox:8025
	}

	# --- everything else is the site --------------------------------------
	handle {
		reverse_proxy docs:8000
	}

	handle_errors {
		respond `waterpark dev proxy: {err.status_code} {err.status_text}

This came from Caddy, not from the application. A 502 means an upstream
container is not answering:

  docker compose -f .dev/compose.yml ps
  docker compose -f .dev/compose.yml logs listmonk
` {err.status_code}
	}
}
